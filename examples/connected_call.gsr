# Golden State Replay demo fixture: captured after a call is connected.
GSR/1
meta scenario "connected_call"
meta capture_point "CALL_CONNECTED_QUIESCENT"
meta schema_hash "demo-schema-v1"

# Heap allocations. `legs` is one allocation containing two MediaLeg objects.
object call CallSession 1
object peer Peer 1
object legs MediaLeg 2

# Platform/process resources are reconstructed by an adapter, never by raw address.
external refresh_timer TimerHandle 9001

# Scalar global and non-pointer fields.
global g_service_ready bool true
scalar call 0 call_id i32 42
scalar call 0 state enum 1
string peer 0 uri "sip:alice@example.test"
scalar legs 0 id i32 10
scalar legs 0 active bool false
scalar legs 1 id i32 20
scalar legs 1 active bool true

# Pointer graph. Object ID + element index preserves aliases, cycles and
# interior pointers without storing process addresses.
edge call 0 peer peer 0
edge call 0 active_leg legs 1
edge call 0 refresh_timer refresh_timer 0
edge peer 0 owner call 0
edge legs 0 owner call 0
edge legs 1 owner call 0
edge legs 0 sibling legs 1
edge legs 1 sibling legs 0
edge root 0 g_call call 0
edge root 0 g_active_leg legs 1

# Expected interaction transcript and selective post-action oracle.
expect_call stop_timer 9001
expect call 0 state enum 2
expect legs 1 active bool false
